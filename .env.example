# ID spreadsheet (bagian di URL: docs.google.com/spreadsheets/d/<INI>/edit)
SHEET_ID=

# Dari file JSON service account
GOOGLE_CLIENT_EMAIL=nama@project.iam.gserviceaccount.com
# Salin private_key apa adanya, dalam tanda kutip, \n boleh tetap berupa teks "\n"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password untuk halaman /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
